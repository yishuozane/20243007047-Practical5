<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp"
    android:background="@color/color_default_background">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Municipalities in China"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/color_text_dark"
        android:gravity="center"
        android:layout_marginTop="45dp"
        android:layout_marginBottom="24dp" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:src="@drawable/chinese_municipalities"
        android:scaleType="fitCenter"
        android:contentDescription="Map of Chinese municipalities"
        android:layout_marginBottom="35dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="I want to know about:"
        android:textSize="18sp"
        android:textColor="@color/color_text_dark"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/municipalityInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter Beijing, Shanghai, Tianjin or Chongqing"
        android:inputType="textCapWords"
        android:singleLine="true"
        android:imeOptions="actionGo" />

</LinearLayout>